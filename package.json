{
  "name": "compcoach",
  "version": "1.0.0",
  "private": true,
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules"
      ],
      "legacy_shallowReactNativeLinking": true
    }
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit --pretty false",
    "typecheck:trace": "tsc -p tsconfig.app.json --noEmit --pretty false --extendedDiagnostics",
    "typecheck:probe-root": "tsc -p tsconfig.probe-root.json --noEmit --pretty false --extendedDiagnostics",
    "typecheck:probe-tabs": "tsc -p tsconfig.probe-tabs.json --noEmit --pretty false --extendedDiagnostics",
    "typecheck:probe-feature": "tsc -p tsconfig.probe-feature.json --noEmit --pretty false --extendedDiagnostics"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@tamagui/animations-react-native": "1.125.26",
    "@tamagui/babel-plugin": "1.125.26",
    "@tamagui/core": "1.125.26",
    "@tamagui/font-inter": "1.125.26",
    "@tamagui/shorthands": "1.125.26",
    "@tamagui/themes": "1.125.26",
    "@tamagui/web": "1.125.26",
    "expo": "^54.0.33",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^11.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "tamagui": "1.125.26"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
